# ===== Alaa El Shami Portfolio — Backend env template =====
# Copy to .env for local dev, and set the same keys in the Render dashboard.

DATABASE_URL=sqlite:///./portfolio.db
SECRET_KEY=change-me-to-a-long-random-string

# Admin login for the dashboard
ADMIN_EMAIL=admin@portfolio.alaaelshami.com
ADMIN_PASSWORD=change-me

# Public site identity (seeds Settings on first run; editable in admin)
SITE_TITLE=Alaa El Shami
SITE_DESCRIPTION=Professional Photographer based in Dubai, UAE
CONTACT_EMAIL=

# Add a future custom domain origin here when migrating (comma-separated)
EXTRA_ORIGINS=

# Media storage
CLOUDINARY_FOLDER=alla-portfolio
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional AI assistant
ANTHROPIC_API_KEY=
